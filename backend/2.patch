diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..1b6c428
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,33 @@
+# ---- Backend (Railway) ----------------------------------------------------
+NODE_ENV=production
+# PORT is injected by Railway; do not set it manually there.
+MONGO_URI=<mongodb+srv://... connection string>          # REQUIRED (the app uses MongoDB/Mongoose, not PostgreSQL)
+JWT_ACCESS_SECRET=<>=32 random chars>                    # REQUIRED
+JWT_REFRESH_SECRET=<>=32 random chars>                   # REQUIRED
+COOKIE_SECRET=<>=32 random chars>                        # REQUIRED
+
+# CORS: production Vercel URL and http://localhost:5173 are built in.
+# Add EXTRA origins here, comma-separated (optional). Never use *.
+CORS_ORIGIN=
+FRONTEND_URL=https://quantum-trust-cloud-pqc.vercel.app
+
+# Object storage (S3-compatible) -- REQUIRED for uploads
+STORAGE_PROVIDER=s3            # minio | s3 | azure
+STORAGE_ENDPOINT=              # leave empty for AWS S3; set for R2/MinIO
+STORAGE_REGION=us-east-1
+STORAGE_BUCKET=<bucket name>
+STORAGE_ACCESS_KEY=<server-side secret>
+STORAGE_SECRET_KEY=<server-side secret>
+STORAGE_FORCE_PATH_STYLE=false # true only for MinIO
+
+# Blockchain (optional; Avalanche Fuji TESTNET)
+CHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
+CHAIN_PRIVATE_KEY=<server-side secret, testnet wallet only>
+AUDIT_CONTRACT_ADDRESS=<deployed audit contract>
+PAYMENT_RECEIVING_ADDRESS=<address>
+STABLECOIN_CONTRACT_ADDRESS=<token contract on Fuji>
+
+# ---- Frontend (Vercel) ----------------------------------------------------
+# Must be the public Railway URL, no trailing slash. Without it the app calls
+# "/api" on the Vercel domain, which does not exist.
+VITE_API_URL=https://<your-service>.up.railway.app
diff --git a/backend/jest.config.cjs b/backend/jest.config.cjs
index 285141b..80896ed 100644
--- a/backend/jest.config.cjs
+++ b/backend/jest.config.cjs
@@ -4,6 +4,8 @@ module.exports = {
   roots: ['<rootDir>/src'],
   testMatch: ['**/*.test.ts'],
   clearMocks: true,
+  // Source uses ESM-style './x.js' specifiers (required by Node ESM); map them back to the .ts files for ts-jest.
+  moduleNameMapper: { '^(\\.{1,2}/.*)\\.js$': '$1' },
   setupFiles: ['<rootDir>/jest.setup.js'],
   // @noble/post-quantum and @noble/hashes ship pure ESM with no CJS
   // build. Node's own `require()` can load them natively at app runtime
@@ -12,7 +14,7 @@ module.exports = {
   // ESM->CJS transform just for the test run.
   transformIgnorePatterns: ['/node_modules/(?!(@noble)/)'],
   transform: {
-    '^.+\\.tsx?$': 'ts-jest',
+    '^.+\\.tsx?$': ['ts-jest', { diagnostics: { ignoreCodes: [2823] } }], // TS2823: JSON import attributes are valid in the ESM build; ts-jest compiles to CJS
     '^.+\\.jsx?$': 'babel-jest',
   },
 };
