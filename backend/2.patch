 backend/jest.config.cjs                   |   4 +-
 backend/package-lock.json                 | 250 ++++++++++++++++++++++
 backend/package.json                      |  11 +-
 backend/src/app.ts                        |  17 +-
 backend/src/config/__tests__/cors.test.ts |  62 ++++++
 backend/src/config/cors.ts                |  44 ++++
 backend/src/config/env.ts                 |  10 +-
 backend/src/server.ts                     |   7 +-
 9 files changed, 422 insertions(+), 16 deletions(-)
 create mode 100644 .env.example
