index 0000000..b454c71
--- /dev/null
+++ b/backend/src/config/__tests__/cors.test.ts
@@ -0,0 +1,62 @@
+import request from 'supertest';
+import { createApp } from '../../app';
+import { buildAllowedOrigins, isOriginAllowed, DEFAULT_ALLOWED_ORIGINS } from '../cors';
+
+const PROD = 'https://quantum-trust-cloud-pqc.vercel.app';
+const DEV = 'http://localhost:5173';
+const EVIL = 'https://evil.example.com';
+
+describe('CORS allowlist helpers', () => {
+  it('always includes production and dev origins', () => {
+    expect(buildAllowedOrigins('', undefined)).toEqual(expect.arrayContaining([PROD, DEV]));
+    expect(DEFAULT_ALLOWED_ORIGINS).toEqual([PROD, DEV]);
+  });
+  it('merges extras, trims trailing slashes, dedupes and ignores wildcards', () => {
+    const list = buildAllowedOrigins(`${PROD}/, https://staging.example.com ,*`, undefined);
+    expect(list).toContain('https://staging.example.com');
+    expect(list).not.toContain('*');
+    expect(list.filter((o) => o === PROD)).toHaveLength(1);
+  });
+  it('rejects unknown origins and permits absent Origin', () => {
+    expect(isOriginAllowed(EVIL)).toBe(false);
+    expect(isOriginAllowed(undefined)).toBe(true);
+    expect(isOriginAllowed(PROD)).toBe(true);
+  });
+});
+
+describe('CORS over HTTP', () => {
+  const app = createApp();
+
+  it.each([PROD, DEV])('answers preflight for %s', async (origin) => {
+    const res = await request(app)
+      .options('/api/auth/login')
+      .set('Origin', origin)
+      .set('Access-Control-Request-Method', 'POST')
+      .set('Access-Control-Request-Headers', 'content-type,authorization');
+    expect(res.status).toBe(204);
+    expect(res.headers['access-control-allow-origin']).toBe(origin);
+    expect(res.headers['access-control-allow-credentials']).toBe('true');
+    expect(res.headers['access-control-allow-methods']).toMatch(/POST/);
+    expect(res.headers['access-control-allow-headers']).toMatch(/authorization/i);
+  });
+
+  it('sends CORS headers on real requests from allowed origins', async () => {
+    const res = await request(app).get('/api/nope').set('Origin', PROD);
+    expect(res.headers['access-control-allow-origin']).toBe(PROD);
+  });
+
+  it('does not grant CORS headers to unauthorized origins (preflight or real)', async () => {
+    const pre = await request(app)
+      .options('/api/auth/login')
+      .set('Origin', EVIL)
+      .set('Access-Control-Request-Method', 'POST');
+    expect(pre.headers['access-control-allow-origin']).toBeUndefined();
+    const real = await request(app).get('/api/nope').set('Origin', EVIL);
+    expect(real.headers['access-control-allow-origin']).toBeUndefined();
+  });
+
+  it('never answers with a wildcard origin', async () => {
+    const res = await request(app).get('/api/nope').set('Origin', PROD);
+    expect(res.headers['access-control-allow-origin']).not.toBe('*');
+  });
+});
diff --git a/backend/src/config/cors.ts b/backend/src/config/cors.ts
new file mode 100644
index 0000000..287a0c3
--- /dev/null
+++ b/backend/src/config/cors.ts
@@ -0,0 +1,44 @@
+import type { CorsOptions } from 'cors';
+import { env } from './env.js';
+
+/** Origins that must always work, regardless of environment variables. */
+export const DEFAULT_ALLOWED_ORIGINS = [
+  'https://quantum-trust-cloud-pqc.vercel.app',
+  'http://localhost:5173',
+];
+
+function normalize(origin: string): string {
+  return origin.trim().replace(/\/+$/, '');
+}
+
+/** Built-in allowlist plus any comma-separated extras from CORS_ORIGIN / FRONTEND_URL. */
+export function buildAllowedOrigins(extra: string = env.CORS_ORIGIN, frontendUrl = process.env.FRONTEND_URL): string[] {
+  const extras = [extra, frontendUrl ?? '']
+    .join(',')
+    .split(',')
+    .map(normalize)
+    .filter((o) => o.length > 0 && o !== '*'); // a wildcard is never honoured with credentials
+  return Array.from(new Set([...DEFAULT_ALLOWED_ORIGINS, ...extras]));
+}
+
+export const allowedOrigins = buildAllowedOrigins();
+
+export function isOriginAllowed(origin: string | undefined, list: string[] = allowedOrigins): boolean {
+  // No Origin header = same-origin / server-to-server / curl; CORS does not apply.
+  if (!origin) return true;
+  return list.includes(normalize(origin));
+}
+
+export const corsOptions: CorsOptions = {
+  origin(origin, callback) {
+    // Disallowed origins get no CORS headers (browser blocks them). We do not
+    // raise an error so preflights are answered cleanly rather than as a 500.
+    callback(null, isOriginAllowed(origin));
+  },
+  credentials: true,
+  methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
+  allowedHeaders: ['Content-Type', 'Authorization', 'X-Requested-With', 'X-Device-Id', 'Idempotency-Key'],
+  exposedHeaders: ['RateLimit-Limit', 'RateLimit-Remaining', 'RateLimit-Reset'],
+  maxAge: 600,
+  optionsSuccessStatus: 204,
+};
