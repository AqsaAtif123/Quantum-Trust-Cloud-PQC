{
  "name": "quantumtrust-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "ts-node --transpile-only scripts/compile.ts",
    "test": "npm run compile && hardhat test --no-compile",
    "test:gas": "npm run compile && REPORT_GAS=true hardhat test --no-compile",
    "deploy:fuji": "npm run compile && hardhat run scripts/deploy.ts --network fuji",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.4",
    "solc": "^0.8.24",
    "typescript": "5.4.5"
  },
  "overrides": {
    "typescript": "5.4.5"
  }
}
